# Application Environment Settings
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security & Authentication
JWT_SECRET=replace-this-with-a-secure-random-32-byte-hex-secret
SESSION_TOKEN_EXPIRE_MINUTES=120

# Provider Configuration (mock | whisper | deepgram | gemini | openai | elevenlabs)
STT_PROVIDER=mock
TRANSLATION_PROVIDER=mock
TTS_PROVIDER=mock

# External AI Provider API Keys (Optional for live production cloud adapters)
GEMINI_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Target Latency Budget (ms)
TARGET_LATENCY_BUDGET_MS=1500

# Privacy & Retention
RETAIN_SESSION_TRANSCRIPTS=false
RETAIN_CALL_AUDIO=false
AUTO_CLEANUP_TEMP_AUDIO=true
